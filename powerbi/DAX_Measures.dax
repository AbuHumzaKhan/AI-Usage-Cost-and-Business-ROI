// Create these measures in Power BI. See docs/POWER_BI_BUILD_GUIDE.md.
Total AI Cost INR = SUM(FactAIUsage[total_cost_inr])
Total AI Requests = DISTINCTCOUNT(FactAIUsage[request_id])
Total Input Tokens = SUM(FactAIUsage[input_tokens])
Total Output Tokens = SUM(FactAIUsage[output_tokens])
AI-Assisted Tasks = CALCULATE(DISTINCTCOUNT(FactWorkOutcome[task_id]), FactWorkOutcome[ai_assisted] = 1)
Total Tasks = DISTINCTCOUNT(FactWorkOutcome[task_id])
AI Adoption Rate = DIVIDE([AI-Assisted Tasks], [Total Tasks])
Accepted Outputs = CALCULATE(DISTINCTCOUNT(FactWorkOutcome[task_id]), FactWorkOutcome[accepted] = 1)
Accepted AI Outputs = CALCULATE(DISTINCTCOUNT(FactWorkOutcome[task_id]), FactWorkOutcome[ai_assisted] = 1, FactWorkOutcome[accepted] = 1)
Cost per Accepted AI Output INR = DIVIDE([Total AI Cost INR], [Accepted AI Outputs])
Gross Minutes Saved = SUMX(FactWorkOutcome, FactWorkOutcome[baseline_minutes] - FactWorkOutcome[actual_minutes])
Net Minutes Saved = SUMX(FactWorkOutcome, FactWorkOutcome[baseline_minutes] - FactWorkOutcome[actual_minutes] - FactWorkOutcome[rework_minutes])
Positive Net Hours Saved = DIVIDE(SUMX(FactWorkOutcome, MAX(0, FactWorkOutcome[baseline_minutes] - FactWorkOutcome[actual_minutes] - FactWorkOutcome[rework_minutes])), 60)
Estimated Capacity Value INR = SUMX(FactWorkOutcome, DIVIDE(MAX(0, FactWorkOutcome[baseline_minutes] - FactWorkOutcome[actual_minutes] - FactWorkOutcome[rework_minutes]), 60) * RELATED(DimTeam[loaded_labor_rate_inr_per_hour]))
Estimated Net Benefit INR = [Estimated Capacity Value INR] - [Total AI Cost INR]
Estimated ROI % = DIVIDE([Estimated Net Benefit INR], [Total AI Cost INR])
Average Quality Score = AVERAGE(FactWorkOutcome[quality_score])
Acceptance Rate = DIVIDE([Accepted Outputs], [Total Tasks])
Average Latency Seconds = AVERAGE(FactAIUsage[latency_seconds])
Failed Requests = CALCULATE([Total AI Requests], FactAIUsage[request_status] = "failed")
Request Failure Rate = DIVIDE([Failed Requests], [Total AI Requests])
